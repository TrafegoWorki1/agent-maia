# Modelo das variáveis do .env. Copie para .env (ou cadastre estas mesmas chaves na Vercel).
# Nunca cole valores reais aqui nem no chat.

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_OWNER_NUMBER=
EVOLUTION_APPROVER_NUMBER=
# URL pública real do webhook em produção (api/webhook.ts na Vercel), sem o ?token. Usada só por
# scripts/register-evolution-webhook.ts. Nunca a do túnel do launcher legado (isso é WEBHOOK_PUBLIC_URL,
# que muda a cada execução do pnpm start:legacy e não deve alimentar este script).
EVOLUTION_WEBHOOK_URL=

# Supabase (projeto Agent Maia). A service role fica só no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Painel (navegador): chave pública (publishable). Pode ir ao navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Zernio (Instagram e LinkedIn de Herickson Maia): só a chave, no servidor
ZERNIO_API_KEY=

# GitHub (ferramentas github_*): token clássico (ghp_...) só com o escopo `repo`. Alternativa ao .env: no privado do WhatsApp,
# `cofre GITHUB_TOKEN | valor` (fica no cofre como INTEGRACAO_GITHUB_TOKEN). O .env tem prioridade.
GITHUB_TOKEN=

# Vercel (ferramenta site_publicar_vercel): token de API pessoal com permissão de deploy. Alternativa ao .env: no privado do
# WhatsApp, `cofre VERCEL_TOKEN | valor` (fica no cofre como INTEGRACAO_VERCEL_TOKEN). O .env tem prioridade.
VERCEL_TOKEN=
# O repositório dos sites não fica aqui: o pedido informa o repositório (dono/nome, privado) em cada ação de site.

# Identificador interno da Maia no WhatsApp (@lid, 15 dígitos). Sem ele, menção em grupo feita pelo @lid não chama a Maia.
# Veja o @ de uma menção à Maia numa mensagem de grupo guardada. Coloque o mesmo valor no ambiente da Vercel.
# MAIA_LID=

# Cofre de segredos das integrações (opcional). 32 bytes em hexadecimal; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTEGRACAO_VAULT_KEY=

# Meta Ads MCP oficial: App ID de um app criado no Meta for Developers.
# Cadastre como URI de redirecionamento OAuth valida:
#   https://agent-maia.vercel.app/api/integration-connections?callback=1
# META_MCP_CLIENT_ID=

# Executor do Claude (opcionais). Padrão: Claude Code CLI; MAIA_CLAUDE_EXECUTOR=sdk volta ao Agent SDK.
# MAIA_CLAUDE_EXECUTOR=cli
# MAIA_CLAUDE_BIN=
# MAIA_CLAUDE_WORKDIR=
# MAIA_CLAUDE_ADD_DIRS=

WHISPER_API_URL=
WHISPER_API_KEY=
